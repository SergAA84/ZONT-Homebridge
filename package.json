{
  "name": "homebridge-zont-thermostat",
  "version": "0.2.2",
  "displayName": "Homebridge ZONT Thermostat",
  "description": "Homebridge plugin for ZONT heating circuits as thermostats",
  "author": "SergAA",
  "license": "MIT",
  "homepage": "https://github.com/SergAA84/ZONT-Homebridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergAA84/ZONT-Homebridge.git"
  },
  "bugs": {
    "url": "https://github.com/SergAA84/ZONT-Homebridge/issues"
  },
  "main": "index.js",
  "scripts": {
    "lint": "node scripts/lint.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=homebridge-ui/** --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 test/*.test.js",
    "check": "npm run lint && npm test"
  },
  "files": [
    "index.js",
    "config.schema.json",
    "lib",
    "homebridge-ui",
    "assets",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "zont",
    "thermostat"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0"
  },
  "devDependencies": {
    "@homebridge/hap-nodejs": "2.3.0",
    "jsdom": "^27.4.0"
  },
  "homebridge": {
    "platformName": "ZontPlatform",
    "pluginAlias": "ZontPlatform",
    "pluginType": "platform",
    "singular": true
  }
}
